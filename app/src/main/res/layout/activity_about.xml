<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rg_surface_variant">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rg_surface"
        app:elevation="3dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:background="@color/rg_surface"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/rg_primary"
            app:title="About"
            app:titleCentered="false"
            app:titleTextColor="@color/rg_on_surface"
            app:subtitle="Community Driven Road Safety"
            app:subtitleTextColor="@color/rg_on_surface_variant" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="36dp">

            <!-- Hero Branding Section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/rg_primary_container"
                app:cardCornerRadius="44dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="App Logo"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/saferoute_logo" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SafeRoute"
                android:textColor="@color/rg_on_surface"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSlogan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Community Driven Road Safety"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/rg_on_surface_variant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAppVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_chip_verified"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="Version 1.0"
                android:textColor="@color/rg_on_primary_container"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Mission Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#F0FDF4"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#D1FAE5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Mission"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/rg_on_surface"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Making roads safer through real-time community reporting, travel alerts, and verified safety intelligence."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/rg_on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Core Features Card (Responsive 2-Column Grid) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/rg_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/rg_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="✨ Core Features"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/rg_on_surface"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="✓ Smart Reports"
                                android:textColor="@color/rg_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="✓ Travel Mode"
                                android:textColor="@color/rg_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Trust System"
                                android:textColor="@color/rg_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="✓ Verification Engine"
                                android:textColor="@color/rg_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Notifications"
                                android:textColor="@color/rg_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Built With Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="8dp"
                android:text="📦 Built With"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/rg_on_surface"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_verified"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Android"
                    android:textColor="@color/rg_on_primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_unverified"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Java"
                    android:textColor="@color/rg_on_tertiary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_disputed"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Firebase"
                    android:textColor="@android:color/holo_red_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_expired"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="OpenStreetMap"
                    android:textColor="@color/rg_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Policies Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/rg_surface"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/rg_outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:text="📜 Terms &amp; Conditions"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/rg_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/rg_outline_variant" />

                    <TextView
                        android:id="@+id/btnOpenSource"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="16dp"
                        android:text="📦 Open Source Licenses"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/rg_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Attribution & Footer -->
            <TextView
                android:id="@+id/tvOsmAttribution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Map data © OpenStreetMap contributors"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/rg_on_surface_variant"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SafeRoute • Safer Roads Together"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/rg_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCopyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="© 2026 SafeRoute"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/rg_on_surface_variant"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
